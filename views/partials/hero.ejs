<section id="hero" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text-col">
      <h1>Guru tidak selalu ada.<br>Bimbingan belajar, bisa.</h1>
      <p class="lede">TEACH FOR ALL adalah asisten belajar berbasis AI yang hanya membutuhkan koneksi minimal — dirancang untuk sekolah di daerah 3T yang kekurangan guru dan infrastruktur.</p>
      <div class="cta-row">
        <a href="#solusi" class="btn btn-dark">Mulai Sekarang</a>
        <a href="#masalah" class="btn btn-outline">Lihat data masalahnya</a>
      </div>
    </div>
    
    <div class="hero-image-col" aria-label="Foto suasana sekolah dan siswa di daerah 3T">
      <div class="photo-collage">
        <!-- Photo 1: Classroom with teacher -->
        <div class="photo-card photo-top">
          <svg viewBox="0 0 400 250" class="collage-svg" aria-label="Suasana kelas dengan guru">
            <rect width="400" height="250" fill="#9B9E93"/>
            <!-- Background classroom details -->
            <rect x="20" y="30" width="120" height="70" fill="#7D8075" rx="4"/> <!-- Whiteboard -->
            <path d="M 0 180 L 400 180 L 400 250 L 0 250 Z" fill="#75776E"/> <!-- Floor -->
            <!-- Teacher figure -->
            <circle cx="280" cy="70" r="18" fill="#D2B48C"/>
            <path d="M 260 90 Q 280 85 300 90 L 305 160 L 255 160 Z" fill="#9E5A47"/>
            <!-- Students desks -->
            <rect x="50" y="140" width="80" height="40" fill="#654321" rx="3"/>
            <circle cx="90" cy="120" r="14" fill="#E0C0A0"/>
            <path d="M 75 135 L 105 135 L 105 170 L 75 170 Z" fill="#3D5A80"/>
            <rect x="170" y="140" width="80" height="40" fill="#654321" rx="3"/>
            <circle cx="210" cy="120" r="14" fill="#D2B48C"/>
            <path d="M 195 135 L 225 135 L 225 170 L 195 170 Z" fill="#D90429"/>
          </svg>
        </div>

        <!-- Photo 2: Rural wooden classroom structure -->
        <div class="photo-card photo-mid">
          <svg viewBox="0 0 400 250" class="collage-svg" aria-label="Sekolah kayu daerah 3T">
            <rect width="400" height="250" fill="#B3A38C"/>
            <!-- Wooden wall planks -->
            <line x1="0" y1="40" x2="400" y2="40" stroke="#8C7A65" stroke-width="2"/>
            <line x1="0" y1="80" x2="400" y2="80" stroke="#8C7A65" stroke-width="2"/>
            <line x1="0" y1="120" x2="400" y2="120" stroke="#8C7A65" stroke-width="2"/>
            <line x1="0" y1="160" x2="400" y2="160" stroke="#8C7A65" stroke-width="2"/>
            <!-- Window frame -->
            <rect x="40" y="30" width="140" height="90" fill="#758A99" stroke="#524336" stroke-width="4"/>
            <!-- Students at wooden table -->
            <rect x="100" y="150" width="220" height="50" fill="#523927" rx="3"/>
            <circle cx="140" cy="130" r="14" fill="#D2B48C"/>
            <path d="M 125 145 L 155 145 L 155 180 L 125 180 Z" fill="#2B2D42"/>
            <circle cx="210" cy="128" r="14" fill="#E0C0A0"/>
            <path d="M 195 143 L 225 143 L 225 180 L 195 180 Z" fill="#90BE6D"/>
            <circle cx="280" cy="130" r="14" fill="#C59B76"/>
            <path d="M 265 145 L 295 145 L 295 180 L 265 180 Z" fill="#F9C74F"/>
          </svg>
        </div>

        <!-- Photo 3: Indonesian elementary students wearing red & white uniforms raising hands -->
        <div class="photo-card photo-bot">
          <svg viewBox="0 0 400 260" class="collage-svg" aria-label="Siswa SD berseragam merah putih">
            <rect width="400" height="260" fill="#E8DCC4"/>
            <!-- Classroom background -->
            <rect x="30" y="20" width="340" height="90" fill="#D0C2A7" rx="4"/>
            <rect x="50" y="35" width="80" height="50" fill="#A4957D"/>
            
            <!-- Student 1 (left) -->
            <circle cx="100" cy="130" r="22" fill="#D2B48C"/> <!-- Face -->
            <path d="M 85 110 Q 100 95 115 110 Z" fill="#222"/> <!-- Hair -->
            <path d="M 75 155 L 125 155 L 125 240 L 75 240 Z" fill="#FFFFFF"/> <!-- White shirt -->
            <path d="M 75 220 L 125 220 L 125 260 L 75 260 Z" fill="#B81D24"/> <!-- Red pants -->
            <!-- Raised arm -->
            <path d="M 115 155 L 135 105 L 148 112 L 125 165 Z" fill="#FFFFFF"/>
            <circle cx="142" cy="104" r="8" fill="#D2B48C"/>

            <!-- Student 2 (center - smiling girl with headscarf/pramuka/school uniform) -->
            <circle cx="200" cy="120" r="24" fill="#E0C0A0"/> <!-- Face -->
            <path d="M 170 100 Q 200 80 230 100 L 235 155 L 165 155 Z" fill="#FFFFFF"/> <!-- Hijab/uniform -->
            <path d="M 170 155 L 230 155 L 230 260 L 170 260 Z" fill="#FFFFFF"/>
            <path d="M 192 155 L 208 155 L 208 200 L 192 200 Z" fill="#B81D24"/> <!-- Red tie -->
            <!-- Raised arm -->
            <path d="M 220 155 L 245 95 L 258 102 L 232 165 Z" fill="#FFFFFF"/>
            <circle cx="251" cy="94" r="8" fill="#E0C0A0"/>

            <!-- Student 3 (right) -->
            <circle cx="300" cy="135" r="22" fill="#C59B76"/>
            <path d="M 285 115 Q 300 100 315 115 Z" fill="#1A1A1A"/>
            <path d="M 275 160 L 325 160 L 325 260 L 275 260 Z" fill="#FFFFFF"/>
            <path d="M 275 225 L 325 225 L 325 260 L 275 260 Z" fill="#B81D24"/>
            <!-- Raised arm -->
            <path d="M 315 160 L 335 110 L 348 117 L 325 170 Z" fill="#FFFFFF"/>
            <circle cx="342" cy="109" r="8" fill="#C59B76"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

